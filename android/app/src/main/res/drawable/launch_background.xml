<?xml version="1.0" encoding="utf-8"?>
<!-- Splash before Android 12: the default (Ember) theme's background and logo. Android 12
     and later use the per-theme splash in values-v31/styles.xml instead. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background_ember"/>
    <item
        android:width="288dp"
        android:height="288dp"
        android:gravity="center"
        android:drawable="@drawable/splash_logo_ember"/>
</layer-list>
